# ============================================================
# WanderViet — Production environment variables
# Domain: https://wandervietuth.shop
# ============================================================

# SePay webhook secret — used to verify HMAC-SHA256 signature
# from header X-SePay-Signature (or x-payment-secret / x-signature).
# Generate a long random string and paste the same value into the
# SePay dashboard webhook config.
PAYMENT_CALLBACK_SECRET=

# (Tương thích tài liệu SePay — alias dùng cùng giá trị với
#  PAYMENT_CALLBACK_SECRET nếu bạn muốn đặt tên rõ ràng hơn.)
SEPAY_WEBHOOK_SECRET=

# === Thông tin tài khoản nhận tiền (HIỂN THỊ TRÊN QR) ========
# THAY bằng thông tin ngân hàng thật của WanderViet trước khi go-live.
# Các giá trị mặc định hiện hard-code trong src/components/site/BookingFlow.tsx
# (BANK_BIN / BANK_ACCOUNT / BANK_OWNER). Sửa trực tiếp tại file đó.
SEPAY_BANK_NAME=TPBank
SEPAY_BANK_ACCOUNT=0865665046
SEPAY_BANK_OWNER=WANDERVIET TRAVEL

# === Site ====================================================
PUBLIC_SITE_URL=https://wandervietuth.shop
